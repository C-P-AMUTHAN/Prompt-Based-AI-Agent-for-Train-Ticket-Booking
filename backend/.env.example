# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/railway-db

# JWT Secret for Authentication
JWT_SECRET=your-secret-key

# SMTP Configuration for Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# For Gmail, use App Password if 2FA is enabled
SMTP_PASS=your-app-password

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# MCP Server Configuration
MCP_API_KEY=your-mcp-api-key
MCP_RATE_LIMIT=10

# Frontend URL for callbacks
FRONTEND_URL=http://localhost:5173

# Test User Credentials (for automation)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpass123

# RapidAPI (Indian Railways) credentials
# Sign up at RapidAPI and subscribe to the Indian Railways Data API
RAILWAYS_API_KEY=your-rapidapi-key-here
RAILWAYS_API_HOST=indian-railways-data-api.p.rapidapi.com